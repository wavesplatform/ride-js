{
  "name": "@waves/ride-js",
  "version": "2.3.0",
  "description": "Js compiler for Ride - Waves smart contract language.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.js --format cjs,esm --dts",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "files": [
    "./dist/index.d.ts",
    "./dist/index.d.cts",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavesplatform/ride-js.git"
  },
  "keywords": [
    "compiler",
    "waves",
    "ride",
    "smart",
    "contracts"
  ],
  "author": "Waves Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wavesplatform/ride-js/issues"
  },
  "homepage": "https://github.com/wavesplatform/ride-js#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@waves/ride-lang": "^1.6.1",
    "@waves/ride-repl": "^1.6.1",
    "@waves/ts-lib-crypto": "^1.5.1-snapshot.2",
    "axios": "^1.13.5",
    "buffer": "^6.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "test-exclude": "^8.0.0",
    "glob": "^13.0.6"
  }
}
